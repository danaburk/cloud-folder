# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Only this email is allowed to sign in (your own Google account)
ALLOWED_EMAIL=you@gmail.com

# The Google Drive folder ID that holds your textbooks/lectures
# (from the folder's URL: https://drive.google.com/drive/folders/THIS_PART)
DRIVE_FOLDER_ID=
